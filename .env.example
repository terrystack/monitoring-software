# Solo servidor (Vercel / vercel dev). Nunca uses el prefijo VITE_.

# Primario: Gemini Flash-Lite vía AI Studio (OpenAI-compatible)
GEMINI_API_KEY=

# Respaldo del agente + Whisper STT
GROQ_API_KEY=

# Opcionales
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
CHAT_MAX_TOKENS=600
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore

